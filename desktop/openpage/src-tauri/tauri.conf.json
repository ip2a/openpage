{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenPage",
  "version": "0.1.0",
  "identifier": "com.openpage.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "OpenPage 录制控制台",
        "width": 980,
        "height": 760
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
