# Default: ignore everything at the repository root.
/*

# Repository metadata and core files.
!/.gitignore
!/README.md
!/platforms.toml
!/pyproject.toml
!/run_debug.sh

# Project whitelist.
!/.github/
!/.github/**
!/desktop/
!/desktop/**
!/examples/
!/examples/**
!/npm/
!/npm/**
!/python/
!/python/**
!/refactor/
!/refactor/**
!/rust/
!/rust/**
!/scripts/
!/scripts/**
!/skills/
!/skills/**
!/tests/
!/tests/**

# Generated files inside whitelisted directories.
**/.DS_Store
**/.pytest_cache/
**/.ruff_cache/
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.so
**/*.dylib
**/*.dll
**/*.egg-info/
**/.venv/
**/.mypy_cache/
**/.coverage
**/node_modules/
**/dist/
**/npm/packages/internal/openpage-bin-*/bin/openpage
**/target/
**/wheelhouse/
**/package-lock.json
**/tsconfig.tsbuildinfo
/desktop/openpage/src-tauri/Cargo.lock
/desktop/openpage/src-tauri/gen/
